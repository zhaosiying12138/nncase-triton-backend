digraph Qwen3offLayer0 {
  graph [rankdir=TB, compound=true, splines=polyline, nodesep=0.34, ranksep=0.50,
         fontsize=15, fontname="DejaVu Sans", labelloc=t,
         label="Qwen3-0.6B --fused-kernel=off layer0, PE=16\nsolid edges: selected data dependencies only; dashed cross edges: HF<->nncase semantic mapping"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=8.5,
        color="#4f5661", margin="0.07,0.045"];
  edge [fontname="DejaVu Sans", fontsize=8, color="#6a7380", arrowsize=0.60];

  subgraph cluster_hf {
    label="Hugging Face Qwen3 op names";
    color="#8fb6df";
    style="rounded";
    hf_input [label="Qwen3Model.forward\lin: input_ids i64[S]\lout: hidden input ids i64[S]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_embed [label="Qwen3Model.embed_tokens\lin: input_ids i64[S]\lparam: weight f16[V,1024]\lout: hidden_states f16[S,1024]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_input_ln [label="Qwen3DecoderLayer.input_layernorm\lin: hidden_states f16[S,1024]\lout: normed hidden f16[S,1024]\leps=1e-06\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_q_proj [label="Qwen3Attention.q_proj\lin: normed hidden f16[S,1024]\lparam: weight f16[1024,2048]\lout: query_states f16[S,16,128]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_q_norm [label="Qwen3Attention.q_norm\lin: query_states f16[S,16,128]\lout: query_states f16[16,S,128]\leps=1e-06\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_rotary [label="Qwen3RotaryEmbedding.forward\lin: position_ids i64[S]\lparam: inv_freq f32[128]\lout: cos/sin f32[S,128]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_rope_q [label="apply_rotary_pos_emb\lin: q f32[16,S,128] + cos/sin\lout: q_rope f32[16,S,128]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_v_proj [label="Qwen3Attention.v_proj\lin: normed hidden f16[S,1024]\lparam: weight f16[1024,1024]\lout: value_states f16[S,8,128]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_k_proj [label="Qwen3Attention.k_proj\lin: normed hidden f16[S,1024]\lparam: weight f16[1024,1024]\lout: key_states f16[S,8,128]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_k_norm [label="Qwen3Attention.k_norm\lin: key_states f16[S,8,128]\lout: key_states f32[8,S,128]\leps=1e-06\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_rope_k [label="apply_rotary_pos_emb\lin: k f32[8,S,128] + cos/sin\lout: k_rope f32[8,S,128]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_cache [label="Cache.update\lin: k/v f16[8,128,S]\lout: paged KV cache side effect\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_attn [label="eager_attention_forward\lin: q f16[16,128,S] + KV cache\lout: attn_output f16[16,128,S]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_o_proj [label="Qwen3Attention.o_proj\lin: attn_output f16[S,2048]\lparam: weight f16[2048,1024]\lout: attn_output f16[S,1024]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_attn_resid [label="Qwen3DecoderLayer.forward residual add\lin: hidden f16[S,1024] + attn f16[S,1024]\lout: residual1 f16[S,1024]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_post_ln [label="Qwen3DecoderLayer.post_attention_layernorm\lin: residual1 f16[S,1024]\lout: post_norm f16[S,1024]\leps=1e-06\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_gate [label="Qwen3MLP.gate_proj\lin: post_norm f16[S,1024]\lout: gate f16[S,3072]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_up [label="Qwen3MLP.up_proj\lin: post_norm f16[S,1024]\lout: up f16[S,3072]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_act_mul [label="Qwen3MLP.act_fn + mul\lin: gate/up f16[S,3072]\lout: hidden f16[S,3072]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_down [label="Qwen3MLP.down_proj\lin: hidden f16[S,3072]\lout: mlp f16[S,1024]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_mlp_resid [label="Qwen3DecoderLayer.forward residual add\lin: residual1 f16[S,1024] + mlp f16[S,1024]\lout: layer0_out f16[S,1024]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hf_layer1 [label="Qwen3DecoderLayer[1].input_layernorm\lboundary only\lin: layer0_out f16[S,1024]\l", fillcolor="#eaf4ff", width=2.95, group="hf"];
    hb_01 [shape=point, style=invis, width=0.02, height=0.02, label=""];
    hb_03 [shape=point, style=invis, width=0.02, height=0.02, label=""];
    hb_08 [shape=point, style=invis, width=0.02, height=0.02, label=""];
    hb_10 [shape=point, style=invis, width=0.02, height=0.02, label=""];
    hb_12 [shape=point, style=invis, width=0.02, height=0.02, label=""];
  }

  subgraph cluster_nncase {
    label="nncase lowered ops, one node per ordinal";
    color="#dfa85e";
    style="rounded";
    n_00 [label="ord00 ccl: input load\nin input_ids: i64[S]\nout ids_s: i64[S] (S0)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_01 [label="ord01: input_ids mask\lin ids_s: i64[S] (S0)\lout mask_s: bool[S] (S0)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_02 [label="ord02 ccl: input load\nin input_ids: i64[S]\nout ids_b: i64[S] (B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_03 [label="ord03: embed_tokens\lin ids_b: i64[S] (B)\lparam embed_w: f16[V,1024] (B,S0)\lout embed_b_s: f16[S,1024] (B,S0)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_04 [label="ord04 ccl: all-to-all reshard\nin embed_b_s: f16[S,1024] (B,S0)\nout embed_s_b: f16[S,1024] (S0,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_05 [label="ord05: embed_tokens materialization + input_layernorm\lin embed_s_b: f16[S,1024] (S0,B)\lout residual0: f16[S,1024] (S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_06 [label="ord06 ccl: all-gather reshard\nin normed_hidden: f16[S,1024] (S0,B)\nout normed_hidden_b: f16[S,1024] (B,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_07 [label="ord07: q_proj\lin normed_hidden_b: f16[S,1024] (B,B)\lout q_proj: f16[S,2048] (B,S0)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_08 [label="ord08: q_norm\lin q_view: f16[S,16,128] (B,S0,B)\lout q_norm_t: f32[16,S,128] (S0,B,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_09 [label="ord09: position_ids\lin kvCache: PagedAttentionKVCache\lout position_ids: f32[S] (S0)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_10 [label="ord10: cos/angle\lin position_ids: f32[S,1] (S0,B)\lout angle_s: f32[S,128] (S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_11 [label="ord11 ccl: all-gather reshard\nin cos_s: f32[S,128] (S0,B)\nout cos_b: f32[S,128] (B,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_12 [label="ord12: sin\lin angle_s: f32[S,128] (S0,B)\lout sin_s: f32[S,128] (S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_13 [label="ord13 ccl: all-gather reshard\nin sin_s: f32[S,128] (S0,B)\nout sin_b: f32[S,128] (B,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_14 [label="ord14: apply_rotary_pos_emb(q)\lin q: f32[16,S,128] (S0,B,B)\lout q_rope: f32[16,S,128] (S0,B,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_15 [label="ord15: Q layout for eager_attention_forward\lin q_rope: f32[16,S,128] (S0,B,B)\lout q_attn: f16[16,128,S] (S0,B,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_16 [label="ord16 ccl: all-to-all reshard\nin normed_hidden: f16[S,1024] (S0,B)\nout kv_input: f16[S,1024] (B,S0)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_17 [label="ord17: matmul\lin kv_input: f16[S,1024] (B,S0)\lparam v_w: f16[1024,1024] (S0,B)\lout v_partial: f16[S,1024] (B,B) Partial=True\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_18 [label="ord18: V cache layout\lin v_view: f16[S,8,128] (B,B,B)\lout v_cache: f16[8,128,S] (B,B,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_19 [label="ord19: k_norm\lin k_view: f16[S,8,128] (S0,B,B)\lout k_norm_t: f32[8,S,128] (B,S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_20 [label="ord20: apply_rotary_pos_emb(k)\lin k: f32[8,S,128] (B,S0,B)\lout k_rope: f32[8,S,128] (B,S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_21 [label="ord21: K cache layout\lin k_rope: f32[8,S,128] (B,S0,B)\lout k_cache: f16[8,128,S] (B,B,S0)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_22 [label="ord22: Cache.update(k)\lin k_cache: f16[8,128,S] (B,B,S0)\lout kvCache: PagedAttentionKVCache\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_23 [label="ord23: Cache.update(v)\lin v_cache: f16[8,128,S] (B,B,B)\lout kvCache: PagedAttentionKVCache\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_24 [label="ord24 ccl: paged attention\nin q_attn: f16[16,128,S] (S0,B,B)\nout attn_out: f16[16,128,S] (S0,B,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_25 [label="ord25: attention output layout\lin attn_out: f16[16,128,S] (S0,B,B)\lout o_proj_in: f16[S,16,128] (B,S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_26 [label="ord26: matmul\lin o_proj_in: f16[S,2048] (B,S0)\lparam o_w: f16[2048,1024] (S0,B)\lout o_partial: f16[S,1024] (B,B) Partial=True\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_27 [label="ord27 ccl: reduce-scatter\nin o_partial: f16[S,1024] (B,B) Partial=True\nout o_s_b: f16[S,1024] (S0,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_28 [label="ord28: attention residual add + post_attention_layern\lin residual0: f16[S,1024] (S0,B)\lout residual1_s: f16[S,1024] (S0,B)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_29 [label="ord29 ccl: all-gather reshard\nin residual1_s: f16[S,1024] (S0,B)\nout residual1: f16[S,1024] (B,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_30 [label="ord30 ccl: all-gather reshard\nin post_norm_s: f16[S,1024] (S0,B)\nout post_norm: f16[S,1024] (B,B)", group="nn", shape="diamond", style="filled", fillcolor="#ffeaea", width="5.0", height="1.35"];
    n_31 [label="ord31: gate_proj + up_proj + act_fn + mul\lin post_norm: f16[S,1024] (B,B)\lout mlp_hidden: f16[S,3072] (B,S0)\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
    n_32 [label="ord32: matmul\lin mlp_hidden: f16[S,3072] (B,S0)\lparam down_w: f16[3072,1024] (S0,B)\lout mlp_partial: f16[S,1024] (B,B) Partial=True\l", group="nn", shape="box", style="rounded,filled", fillcolor="#fff4e5", width="3.75"];
